# Copy to .env.local for development; set the same names as Railway variables in production.

# Postgres. Local: docker compose up -d (see docker-compose.yml).
# Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://myday:myday@localhost:5433/myday?schema=public"

# Auth.js. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Full origin of the app. Local: http://localhost:3000
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google Cloud OAuth client (type Web application).
# Redirect URIs: http://localhost:3000/api/auth/callback/google and <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The only Google account allowed to sign in.
ALLOWED_EMAIL=""

# AES-256-GCM key for the Google refresh token. 32 random bytes, base64.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Mistral: extraction and voice transcription (milestone 5).
MISTRAL_API_KEY=""

# Web push. Generate: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Who to contact about these pushes, as the VAPID spec wants.
VAPID_SUBJECT="mailto:you@example.com"

TZ="Europe/Berlin"

# Shared secret between the worker service and /api/sync.
# Generate: openssl rand -base64 24
WORKER_SECRET=""
